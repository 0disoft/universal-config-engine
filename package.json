{
  "name": "universal-config-engine-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0disoft/universal-config-engine.git"
  },
  "bugs": {
    "url": "https://github.com/0disoft/universal-config-engine/issues"
  },
  "homepage": "https://github.com/0disoft/universal-config-engine#readme",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm run build && pnpm run typecheck:built",
    "typecheck:built": "pnpm -r typecheck:built",
    "test": "pnpm run build && pnpm run test:built",
    "test:built": "pnpm -r test:built",
    "clean:build": "node scripts/clean-build-output.mjs",
    "check:adapter-fixtures": "node scripts/check-adapter-fixtures.mjs",
    "check:smoke-tools": "node --test scripts/lib/package-tools.test.mjs",
    "check:release-scripts": "node --test scripts/record-publication-state.test.mjs scripts/check-stable-release-readiness.test.mjs scripts/release-commit-evidence.test.mjs scripts/governance-policy.test.mjs scripts/wait-for-registry-packages.test.mjs scripts/prepare-release-assets.test.mjs",
    "check:governance": "node scripts/check-governance.mjs",
    "check:workflow-actions": "node --test scripts/check-workflow-action-pins.test.mjs && node scripts/check-workflow-action-pins.mjs",
    "check:complexity": "pnpm --filter @0disoft/universal-config-engine-node... build && pnpm run check:complexity:built",
    "check:complexity:built": "node scripts/check-complexity-bounds.mjs",
    "check:no-secret-snapshots": "node --test scripts/check-no-secret-snapshots.test.mjs && node scripts/check-no-secret-snapshots.mjs",
    "check:api-snapshot": "pnpm run build && node scripts/check-public-api-snapshot.mjs",
    "update:api-snapshot": "pnpm run build && node scripts/check-public-api-snapshot.mjs --update",
    "benchmark:merge-trie": "pnpm --filter @0disoft/universal-config-engine-core build && node scripts/benchmark-merge-trie.mjs",
    "benchmark:argv": "pnpm --filter @0disoft/universal-config-engine-node... build && node scripts/benchmark-argv.mjs",
    "smoke:core-package": "node scripts/smoke-core-package.mjs",
    "smoke:packages": "node scripts/smoke-packages.mjs",
    "smoke:consumer-matrix": "node scripts/smoke-consumer-matrix.mjs",
    "smoke:registry-packages": "node scripts/smoke-registry-packages.mjs",
    "verify:registry-packages": "node scripts/wait-for-registry-packages.mjs",
    "check": "pnpm run build && pnpm run typecheck:built && node scripts/check-public-api-snapshot.mjs && pnpm run test:built && pnpm run check:no-secret-snapshots && pnpm run check:adapter-fixtures && pnpm run check:release-scripts && pnpm run check:workflow-actions && pnpm run check:smoke-tools && pnpm run check:complexity:built && pnpm run clean:build"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^5.0.5",
    "fast-check": "4.9.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.6",
    "vitest": "^5.0.5"
  }
}
